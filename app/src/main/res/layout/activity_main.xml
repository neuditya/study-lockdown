<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="STUDY LOCKDOWN"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.25" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="STATUS: FREE"
            android:textColor="@color/nothing_red"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15" />

        <Button
            android:id="@+id/btnToggleLockdown"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_toggle_button"
            android:text="START\nLOCKDOWN"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Time remaining: --:--"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvPasses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Passes left today: 2/2"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:background="@color/dot_grey" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SET STUDY TIMER (MINUTES)"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15" />

        <EditText
            android:id="@+id/editTimerMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. 45"
            android:inputType="number"
            android:maxLength="4"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/dot_grey_light"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnStartTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:text="SET TIMER &amp; LOCK"
            android:textColor="@color/white"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnEmergencyUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input_field"
            android:text="EMERGENCY UNLOCK"
            android:textColor="@color/nothing_red"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnEnableAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:text="ENABLE ACCESSIBILITY SERVICE"
            android:textColor="@color/white"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
